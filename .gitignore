# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
scripts/.export-test-output/

# dev spikes and QA artifacts
/spike-phase0/
/spike-phase0-1/
/spike-phase0-time/
/qa-phase1-timeline/
/public/previews/

# dev-only scripts (not used by build or runtime)
/scripts/browser-*
/scripts/verify-*
/scripts/preview-forced-watermark.mjs

# next.js
/.next/
/out/

# production
/build

# Generated ffmpeg.wasm assets (copied from node_modules on install/build)
/public/ffmpeg/

# misc
.DS_Store
*.pem
supabase/.temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
